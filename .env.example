# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN CODEGYM (HR & ADMIN INTERN PORTAL)
# ==============================================================================

# Cổng chạy Backend Express Server
PORT=5000

# Cấu hình Cơ sở dữ liệu MySQL (XAMPP mặc định)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codegym

# Chuỗi bí mật JWT ký Token (Bắt buộc phải có, không được để trống)
JWT_SECRET=codegym_super_secret_jwt_key_2026_production

# URL gốc của hệ thống (Dùng để chèn liên kết trong email và chuyển hướng)
APP_BASE_URL=http://localhost:5000

# Cấu hình CORS cho phép các domain truy cập (ngăn cách bởi dấu phẩy)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# Môi trường chạy: development | test | production
NODE_ENV=development

# Cấu hình gửi Email SMTP (Để trống nếu dùng Ethereal tự động cho môi trường test/dev)
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
