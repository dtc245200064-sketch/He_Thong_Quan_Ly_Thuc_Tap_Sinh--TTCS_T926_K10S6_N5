{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // Cấu hình mở trực tiếp dashboard.html bằng Edge
        {
            "name": "Open dashboard.html (Edge)",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/frontend/dashboard.html"
        },
        // Cấu hình mở trực tiếp index.html bằng Edge
        {
            "name": "Open index.html (Edge)",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/frontend/index.html"
        },
        // Cấu hình Debug cho Edge qua Localhost
        {
            "name": "Launch Edge (localhost:5500)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5500/frontend",
            "webRoot": "${workspaceFolder}/frontend"
        },
        // Cấu hình mở trực tiếp index.html bằng Chrome
        {
            "name": "Open index.html (Chrome)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/frontend/index.html"
        },
        // Cấu hình Debug cho Chrome qua Localhost
        {
            "name": "Launch Chrome (localhost:5500)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5500/frontend",
            "webRoot": "${workspaceFolder}/frontend"
        },
        // Cấu hình khởi chạy máy chủ Backend (Node.js Express)
        {
            "name": "Start Backend Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/backend/server.js",
            "cwd": "${workspaceFolder}/backend"
        }
    ]
}